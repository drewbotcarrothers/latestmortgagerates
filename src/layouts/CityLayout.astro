---
import BaseLayout from "./BaseLayout.astro";
import CityPage from "../views/cities/CityPage";
import { getCitySeo } from "../lib/cityContent";
import { isIndexedCity } from "../lib/cities";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const seo = getCitySeo(slug);
const indexed = isIndexedCity(slug);
const buildDateIso = new Date().toISOString();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  keywords={seo.keywords}
  noIndex={!indexed}
  robots={indexed ? undefined : "noindex, follow"}
>
  <CityPage slug={slug} buildDateIso={buildDateIso} client:load />
</BaseLayout>
