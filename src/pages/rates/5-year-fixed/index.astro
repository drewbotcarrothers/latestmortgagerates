---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Page from "../../../views/rates/FiveYearFixedPage";
import { publishedRates as ratesData } from "../../../lib/publishedRates";
import { lenderCountLabel } from "../../../lib/lenderCount";

interface Rate {
  rate: number;
  term_months: number;
  rate_type: string;
  mortgage_type: string;
}

const filtered = (ratesData as Rate[]).filter((r) => r.term_months === 60 && r.rate_type === "fixed");
const bestUninsured = filtered.filter((r) => r.mortgage_type === "uninsured").sort((a, b) => a.rate - b.rate)[0];
const bestInsured = filtered.filter((r) => r.mortgage_type === "insured").sort((a, b) => a.rate - b.rate)[0];
const u = bestUninsured?.rate.toFixed(2) || "N/A";
const i = bestInsured?.rate.toFixed(2) || "N/A";
const buildDateIso = new Date().toISOString();
---
<BaseLayout
  title="5-Year Fixed Mortgage Rates Canada | Best Rates & Comparison"
  description={`Compare the best 5-year fixed mortgage rates in Canada. Best uninsured: ${u}%, best insured: ${i}%. Updated daily from ${lenderCountLabel} lenders.`}
  canonical="https://latestmortgagerates.ca/rates/5-year-fixed/"
>
  <Page buildDateIso={buildDateIso} client:load />
</BaseLayout>
