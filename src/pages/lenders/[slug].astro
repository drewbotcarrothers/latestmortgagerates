---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LenderPage from "../../views/lenders/LenderPage";
import ratesData from "../../../data/rates.json";
import lenderContentData from "../../content/lenderContent.json";
import { formatBuildMonthYear } from "../../lib/buildDate";
import { lenderRatesKeyword, lenderSeoDescription, lenderSeoTitle, type LenderRateRow } from "../../lib/lenderSeo";

interface Rate {
  lender_name: string;
  lender_slug: string;
  term_months: number;
  rate_type: string;
  rate: number;
  mortgage_type?: string | null;
}

interface LenderContent {
  tagline?: string;
  overview?: string;
  seoTitle?: string;
  seoDescription?: string;
  seoKeywords?: string[];
}

export function getStaticPaths() {
  const uniqueLenders = [...new Set((ratesData as Rate[]).map((r) => r.lender_slug))];
  return uniqueLenders.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lenderRates = (ratesData as Rate[]).filter((r) => r.lender_slug === slug);
const lenderName = lenderRates[0]?.lender_name || slug;
const content = (lenderContentData as Record<string, LenderContent>)[slug || ""] || {};
const builtAt = new Date();
const monthYear = formatBuildMonthYear(builtAt);
const title = lenderSeoTitle(slug || "", lenderName, monthYear, content.seoTitle);
const description = lenderSeoDescription({
  slug: slug || "",
  lenderName,
  stored: content.seoDescription,
  tagline: content.tagline,
  rates: lenderRates as LenderRateRow[],
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={`https://latestmortgagerates.ca/lenders/${slug}/`}
  keywords={[lenderRatesKeyword(lenderName), `${lenderName} rates`, "Canadian mortgage rates", ...(content.seoKeywords || [])].join(", ")}
>
  <LenderPage slug={slug!} buildDateIso={builtAt.toISOString()} client:load />
</BaseLayout>
