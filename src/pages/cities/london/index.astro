---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CityPage from "../../../views/cities/CityPage";
import { getCitySeo } from "../../../lib/cityContent";

const seo = getCitySeo("london");
---
<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  keywords={seo.keywords}
>
  <CityPage slug="london" client:load />
</BaseLayout>
