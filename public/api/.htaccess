# Widget/clients fetch these static JSON files from other origins.
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type"
  Header set Cache-Control "public, max-age=3600"
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
</IfModule>

DirectoryIndex index.html index.json

# `version` is an extensionless JSON file. `rates/` is a directory whose
# index.html body is also JSON (Hostinger leftover mix after Astro FTP).
<FilesMatch "^(version|version\.json|rates\.json|index\.html|index\.json)$">
  ForceType application/json
</FilesMatch>
